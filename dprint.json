{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "incremental": false,
  "includes": ["**/*.md"],
  "excludes": [".direnv/**", ".venv/**", "artifacts/**", "data/**", "work/**"],
  "markdown": {
    "emphasisKind": "underscores",
    "strongKind": "asterisks",
    "textWrap": "never"
  },
  "plugins": ["https://plugins.dprint.dev/markdown-0.20.0.wasm"]
}
