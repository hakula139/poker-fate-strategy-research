{
  "version": "0.2",
  "language": "en,en-GB",
  "useGitignore": true,
  "allowCompoundWords": true,
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./.cspell/words.txt",
      "addWords": true
    },
    {
      "name": "known-typos",
      "path": "./.cspell/typos.txt"
    }
  ],
  "dictionaries": ["project-words", "known-typos"],
  "ignorePaths": ["flake.lock", "uv.lock"]
}
